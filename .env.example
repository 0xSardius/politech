# ── Agent ────────────────────────────────────────────────
# Both values come from the same app in the Neynar dev portal
# (dev.neynar.com): the app's API key, and the signer_uuid shown
# when you create the Politech agent account inside that app.
NEYNAR_API_KEY=
POLITECH_SIGNER_UUID=

# Anthropic API key for commentary / meta-analysis (M3)
ANTHROPIC_API_KEY=

# true = keep a long-running loop; false = single pass (cron)
POLITECH_RUN_LOOP=false

# true = run the full pipeline but log instead of casting.
# Flip to false only when the pipeline output is trustworthy.
POLITECH_DRY_RUN=true

# Channel to publish into. Use a test channel while iterating.
POLITECH_CHANNEL_ID=politics

# Path to the JSON-file store (week 1). Postgres replaces this at launch.
POLITECH_DATA_FILE=./data/store.json

# Postgres for launch (unused while on the JSON store)
DATABASE_URL=

# ── Mini app (M5) ────────────────────────────────────────
# Deployed domain — must match the /.well-known/farcaster.json host
NEXT_PUBLIC_URL=
